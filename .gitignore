# Python
__pycache__/
*.py[cod]
# Match any venv variant, not just ".venv/" — a renamed backup once slipped
# past a bare ".venv/" rule and staged ~11,000 files.
.venv*
venv*/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
frontend/dist/
*.log

# Local data & artifacts
*.db
*.sqlite3
backend/artifacts/
# backend/data/cache/ IS committed: the App Runner build ingests from it, so
# deploys never depend on the Jolpica API being reachable.
backend/data/exports/

# Secrets -- never commit these
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/

# TypeScript incremental build cache
*.tsbuildinfo
