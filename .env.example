# =============================================================================
# ApexStrategy AI -- environment configuration
#
# Copy to backend/.env for local development:
#     cp .env.example backend/.env
#
# In AWS, DO NOT use a .env file. Supply these through App Runner's environment
# configuration, with secrets referenced from AWS Secrets Manager.
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database ----------------------------------------------------------------
# Local default is SQLite, which needs no setup at all.
DATABASE_URL=sqlite:///./apexstrategy.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://apex:apex_local_password@localhost:5432/apexstrategy
# Amazon RDS: prefer DB_SECRET_ARN below so no password is ever in an env var.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:apexstrategy/database

# --- Auth --------------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AWS / Amazon Bedrock ----------------------------------------------------
AWS_REGION=us-east-1
# Leave false to use the built-in template narrator: the whole product works
# without AWS credentials, just with less fluent prose.
ENABLE_BEDROCK=false
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1600
BEDROCK_TEMPERATURE=0.2

# --- Amazon S3 (optional) ----------------------------------------------------
# Raw datasets, processed files, model artifacts and exported reports.
# S3_BUCKET=apexstrategy-artifacts
S3_MODEL_PREFIX=models/
S3_DATASET_PREFIX=datasets/

# --- Machine learning --------------------------------------------------------
MODEL_DIR=./artifacts
MODEL_FILE=podium_model.joblib

# --- Data ingestion ----------------------------------------------------------
ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
INGEST_SEASONS=2021,2022,2023,2024,2025

# --- CORS --------------------------------------------------------------------
# Only needed when the frontend runs on a different origin (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
